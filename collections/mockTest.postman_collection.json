                  "    const jsonData = pm.response.json(); // 把接口返回的 JSON 响应体转换成 JavaScript 对象\r",
                  "    pm.expect(jsonData.total).to.be.a(\"number\"); // 断言接口文档字段 total 必须是数字类型\r",
                  "    pm.expect(jsonData.discountedTotal).to.be.a(\"number\"); // 断言接口文档字段 discountedTotal 必须是数字类型\r",
                  "}); // 结束“返回购物车金额字段”这个测试用例\r",
                  "\r",
                  "pm.test(\"返回商品总数和总数量\", function () { // 定义一个测试用例：检查商品统计字段\r",
                  "    const jsonData = pm.response.json(); // 把接口返回的 JSON 响应体转换成 JavaScript 对象\r",
                  "    pm.expect(jsonData.totalProducts).to.be.a(\"number\"); // 断言接口文档字段 totalProducts 必须是数字类型\r",
                  "    pm.expect(jsonData.totalQuantity).to.be.a(\"number\"); // 断言接口文档字段 totalQuantity 必须是数字类型\r",
                  "}); // 结束“返回商品总数和总数量”这个测试用例"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
