              "    pm.response.to.have.status(404);\r",
              "});\r",
              "\r",
              "// 测试用例 2：检查接口返回的 JSON 数据是不是空对象 {}\r",
              "// 因为文章不存在，所以接口没有返回 title、body、userId 等文章信息\r",
              "pm.test(\"返回空对象\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.deep.eql({});\r",
              "});\r",
              "\r",
              "// 测试用例 3：检查返回结果里没有 title 字段\r",
              "// 如果不存在的文章还返回了 title，说明接口数据可能有问题\r",
              "pm.test(\"不返回文章 title\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.not.have.property(\"title\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/posts/{{invalid_post_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "posts",
            "{{invalid_post_id}}"
          ]
        }
      },
      "response": []
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "// 公共测试用例 1：检查接口响应时间是否小于 3000ms\r",
          "// 这个断言可以放在 Collection 级别，让集合里的每个请求都自动执行\r",
          "pm.test(\"公共断言：响应时间小于 3000ms\", function () {\r",
          "    // pm.response.responseTime 表示当前接口的响应耗时，单位是毫秒\r",
          "    // below(3000) 表示响应时间必须小于 3000ms，也就是 3 秒\r",
          "    pm.expect(pm.response.responseTime).to.be.below(3000);\r",
          "});\r",
          "\r",
          "// 公共测试用例 2：检查接口没有出现服务器错误\r",
          "// 5xx 状态码通常表示服务器异常，比如 500、502、503、504\r",
          "pm.test(\"公共断言：没有服务器 5xx 错误\", function () {\r",
          "    // pm.response.code 表示当前接口返回的 HTTP 状态码\r",
          "    // below(500) 表示状态码必须小于 500，也就是不能出现服务器错误\r",
          "    pm.expect(pm.response.code).to.be.below(500);\r",
          "});"
        ]
      }
    }
  ]
}
