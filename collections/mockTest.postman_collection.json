  "item": [
    {
      "name": "Auth-登录鉴权流程",
      "item": [
        {
          "name": "07-登录获取Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 测试用例 1：检查登录接口是否请求成功\r",
                  "// HTTP 状态码 200 通常表示请求成功\r",
                  "pm.test(\"状态码是 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// 测试用例 2：检查接口是否返回 accessToken\r",
                  "// accessToken 通常用于后续接口鉴权，比如查询用户信息、创建订单等\r",
                  "pm.test(\"返回 accessToken\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
                  "    // 判断 accessToken 是字符串类型\r",
                  "    pm.expect(jsonData.accessToken).to.be.a(\"string\");\r",
                  "\r",
                  "    // 判断 token 长度大于 20，避免返回空字符串或明显异常的短 token\r",
                  "    pm.expect(jsonData.accessToken.length).to.be.above(20);\r",
                  "});\r",
                  "\r",
                  "// 测试用例 3：检查返回的用户名是否正确\r",
                  "// 用接口返回的 username 和环境变量里的 username 做对比\r",
                  "pm.test(\"用户名返回正确\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
                  "    // 判断返回的用户名是否等于当前环境变量中的 username\r",
                  "    pm.expect(jsonData.username).to.eql(pm.environment.get(\"username\"));\r",
                  "});\r",
                  "\r",
                  "// 测试用例 4：把登录接口返回的 token 保存到环境变量\r",
                  "// 后续需要登录态的接口，可以直接使用 {{access_token}} 或 {{refresh_token}}\r",
                  "pm.test(\"保存 accessToken 和 refreshToken\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
                  "    // 保存 accessToken，后续接口一般放到 Authorization 请求头中\r",
                  "    pm.environment.set(\"access_token\", jsonData.accessToken);\r",
                  "\r",
                  "    // 保存 refreshToken，用于 accessToken 过期后的刷新登录状态\r",
                  "    pm.environment.set(\"refresh_token\", jsonData.refreshToken);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"username\": \"{{username}}\",\r\n  \"password\": \"{{password}}\",\r\n  \"expiresInMins\": 30\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{dummy_base_url}}/auth/login",
              "host": [
                "{{dummy_base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "08-获取当前登录用户",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 测试用例 1：检查获取当前用户信息接口是否请求成功\r",
                  "// HTTP 状态码 200 表示请求成功\r",
                  "pm.test(\"状态码是 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// 测试用例 2：检查返回的用户是不是当前登录用户\r",
                  "// 把接口返回的 username 和环境变量中的 username 做比较\r",
                  "pm.test(\"返回当前登录用户\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
                  "    // 如果两边相等，说明 token 对应的确实是当前登录账号\r",
                  "    pm.expect(jsonData.username).to.eql(pm.environment.get(\"username\"));\r",
                  "});\r",
                  "\r",
                  "// 测试用例 3：检查返回结果中是否包含 email 字段\r",
                  "// 用户信息接口通常应该返回邮箱、用户名、头像等基础信息\r",
                  "pm.test(\"返回包含 email\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
                  "    // 判断响应 JSON 里是否存在 email 这个字段\r",
                  "    pm.expect(jsonData).to.have.property(\"email\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{dummy_base_url}}/auth/me",
              "host": [
                "{{dummy_base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "09-错误Token访问当前用户",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 测试用例 1：检查未授权访问时是否返回 401\r",
                  "// 401 Unauthorized 表示没有登录、token 缺失或 token 无效\r",
                  "pm.test(\"状态码是 401\", function () {\r",
                  "    pm.response.to.have.status(401);\r",
                  "});\r",
                  "\r",
                  "// 测试用例 2：检查未授权时不会返回用户隐私信息\r",
                  "// 未登录或 token 错误时，接口不应该泄露 username、email 等用户数据\r",
                  "pm.test(\"未授权时不返回用户信息\", function () {\r",
                  "    // 这里用 text() 获取原始响应内容\r",
                  "    // 因为错误响应有时不是标准 JSON，直接 response.json() 可能会报错\r",
                  "    const responseText = pm.response.text();\r",
                  "\r",
                  "    // 响应内容中不应该包含 username\r",
                  "    pm.expect(responseText).to.not.include(\"username\");\r",
                  "\r",
                  "    // 响应内容中不应该包含 email\r",
                  "    pm.expect(responseText).to.not.include(\"email\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "wrong_token_123",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer wrong_token_123",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{dummy_base_url}}/auth/me",
              "host": [
                "{{dummy_base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Data-数据驱动",
      "item": [
        {
          "name": "05-数据驱动查询文章",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 测试用例 1：检查状态码是否是 200\r",
                  "pm.test(\"状态码是 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "\r",
                  "// 测试用例 2：检查返回文章 id 是否和当前测试数据一致\r",
                  "pm.test(\"返回文章 id 与当前测试数据一致\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
                  "    // 从环境变量中取出这次期望的文章 ID\r",
                  "    const expectedId = Number(pm.environment.get(\"expected_post_id\"));\r",
                  "\r",
                  "    // 检查返回结果里的 id 是否等于 expected_post_id\r",
                  "    pm.expect(jsonData.id).to.eql(expectedId);\r",
                  "});\r",
                  "\r",
                  "\r",
                  "// 测试用例 3：检查返回中包含 title 和 body\r",
                  "pm.test(\"返回包含 title 和 body\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
                  "    pm.expect(jsonData).to.have.property(\"title\");\r",
                  "    pm.expect(jsonData).to.have.property(\"body\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// 定义一组要测试的文章 ID\r",
                  "// 这里相当于我们手动准备了一组测试数据：[1, 2, 3, 4, 5]\r",
                  "const postIds = [1, 2, 3, 4, 5];\r",
                  "\r",
                  "// 从环境变量里获取当前执行到第几个 ID\r",
                  "// 如果第一次运行，还没有 current_index，就默认从 0 开始\r",
                  "let currentIndex = Number(pm.environment.get(\"current_index\") || 0);\r",
                  "\r",
                  "// 根据 currentIndex 从 postIds 数组里取出当前要测试的文章 ID\r",
                  "// 第一次 currentIndex = 0，取到 postIds[0]，也就是 1\r",
                  "const currentPostId = postIds[currentIndex];\r",
                  "\r",
                  "// 把当前文章 ID 保存到环境变量 current_post_id\r",
                  "// URL 里的 {{current_post_id}} 会读取这个值\r",
                  "pm.environment.set(\"current_post_id\", currentPostId);\r",
                  "\r",
                  "// 把期望的文章 ID 也保存起来，方便 Tests 里断言\r",
                  "pm.environment.set(\"expected_post_id\", currentPostId);\r",
                  "\r",
                  "// currentIndex 加 1，准备给下一次运行使用\r",
                  "currentIndex = currentIndex + 1;\r",
                  "\r",
                  "// 如果已经跑完 1、2、3、4、5，就重置为 0\r",
                  "// 这样下次重新运行时，又会从 1 开始\r",
                  "if (currentIndex >= postIds.length) {\r",
                  "    currentIndex = 0;\r",
                  "}\r",
                  "\r",
                  "// 保存新的 current_index\r",
                  "pm.environment.set(\"current_index\", currentIndex);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts/{{current_post_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                "{{current_post_id}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Project02-电商购物车流程",
      "item": [
        {
          "name": "新建 10-查询商品详情",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 测试用例 1：检查接口返回的 HTTP 状态码是不是 200\r",
                  "// 200 表示请求成功\r",
                  "pm.test(\"状态码是 200\", function () {\r",
                  "    // pm.response 表示接口返回的响应\r",
                  "    // to.have.status(200) 表示期望状态码等于 200\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "\r",
                  "// 测试用例 2：检查返回的商品 id 是否正确\r",
                  "// 目的是确认接口返回的是我们要查询的那个商品\r",
                  "pm.test(\"商品 id 正确\", function () {\r",
                  "    // 把接口返回的 JSON 字符串转换成 JavaScript 对象\r",
                  "    // 这样才能通过 jsonData.id、jsonData.price 这种方式取字段\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
                  "    // 从当前 Postman 环境变量中获取 product_id\r",
                  "    // 注意：环境变量取出来默认是字符串，比如 \"1\"\r",
                  "    // Number(...) 是把字符串 \"1\" 转成数字 1\r",
                  "    const expectedProductId = Number(pm.environment.get(\"product_id\"));\r",
                  "\r",
                  "    // 检查响应里的 id 是否等于环境变量里的 product_id\r",
                  "    // eql 表示严格比较，值和类型都要匹配\r",
                  "    pm.expect(jsonData.id).to.eql(expectedProductId);\r",
                  "});\r",
                  "\r",
                  "\r",
                  "// 测试用例 3：检查商品是否包含价格和库存\r",
                  "// 目的是确认商品详情接口返回了关键业务字段\r",
                  "pm.test(\"商品包含价格和库存\", function () {\r",
                  "    // 解析接口返回的 JSON 数据\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
                  "    // 检查 price 字段是不是数字类型\r",
                  "    // price 表示商品价格，正常应该是 number\r",
                  "    pm.expect(jsonData.price).to.be.a(\"number\");\r",
                  "\r",
                  "    // 检查 stock 字段是不是数字类型\r",
                  "    // stock 表示商品库存，正常也应该是 number\r",
                  "    pm.expect(jsonData.stock).to.be.a(\"number\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{dummy_base_url}}/products/{{product_id}}",
              "host": [
                "{{dummy_base_url}}"
              ],
              "path": [
                "products",
                "{{product_id}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "新建 11-加入购物车",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 接口：POST {{dummy_base_url}}/carts/add\r",
                  "// 作用：把商品加入购物车\r",
                  "// 环境变量值：dummy_base_url、ecommerce_user_id、product_id、product_quantity\r",
                  "// 接口文档字段：id、products、userId、total、totalQuantity、totalProducts\r",
                  "\r",
                  "pm.test(\"状态码是 201\", function () {\r",
                  "    // 201 是接口文档定义的创建成功状态码\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"返回购物车 id，并保存到环境变量\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
                  "    // jsonData.id 是接口返回的购物车 id，不是商品 id\r",
                  "    pm.expect(jsonData.id).to.be.a(\"number\");\r",
                  "\r",
                  "    // created_cart_id 是我们自己定义的环境变量，供后续查询/修改使用\r",
                  "    pm.environment.set(\"created_cart_id\", jsonData.id);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"返回的 userId 正确\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
                  "    // ecommerce_user_id 是环境变量\r",
                  "    const expectedUserId = Number(pm.environment.get(\"ecommerce_user_id\"));\r",
                  "\r",
                  "    // userId 是接口文档返回字段\r",
                  "    pm.expect(jsonData.userId).to.eql(expectedUserId);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"商品 id 和数量正确\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
                  "    // product_id、product_quantity 是环境变量\r",
                  "    const expectedProductId = Number(pm.environment.get(\"product_id\"));\r",
                  "    const expectedQuantity = Number(pm.environment.get(\"product_quantity\"));\r",
                  "\r",
                  "    // products 是接口文档返回字段，商品信息在 products[0] 里\r",
                  "    pm.expect(jsonData.products[0].id).to.eql(expectedProductId);\r",
                  "    pm.expect(jsonData.products[0].quantity).to.eql(expectedQuantity);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"购物车金额和总数量正确\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
                  "    // total、totalQuantity 是接口文档返回字段\r",
                  "    pm.expect(jsonData.total).to.be.above(0);\r",
                  "    pm.expect(jsonData.totalQuantity).to.eql(Number(pm.environment.get(\"product_quantity\")));\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"userId\": {{ecommerce_user_id}},\r\n  \"products\": [\r\n    {\r\n      \"id\": {{product_id}},\r\n      \"quantity\": {{product_quantity}}\r\n    }\r\n  ]\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{dummy_base_url}}/carts/add",
              "host": [
                "{{dummy_base_url}}"
              ],
              "path": [
                "carts",
                "add"
              ]
            }
          },
          "response": []
        },
        {
          "name": "12-查询购物车详情",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 接口名称：12-查询购物车详情\r",
                  "// 请求方式：GET\r",
                  "// 请求地址：{{dummy_base_url}}/carts/{{cart_id}}\r",
                  "// 环境变量值：dummy_base_url、cart_id\r",
                  "// 接口文档字段：id、products、total、discountedTotal、userId、totalProducts、totalQuantity\r",
                  "\r",
                  "pm.test(\"状态码是 200\", function () { // 定义一个测试用例：检查 HTTP 状态码是否为 200\r",
